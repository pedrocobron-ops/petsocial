NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canônica do site em produção (usada em SEO, sitemap e RSS)
NEXT_PUBLIC_SITE_URL=https://maestropet.com

# Google AdSense — deixe vazio até a conta ser aprovada.
# Depois de aprovado, cole o ID do editor (ex.: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT=
